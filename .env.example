# Copy to .env.local. Never commit .env.local.
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.

# Base URL of the Django API (cladasafari-api), without a trailing /api: the
# app adds /api/... itself.
#   local development          NEXT_PUBLIC_API_URL=http://localhost:8001
#   API on its own subdomain   NEXT_PUBLIC_API_URL=https://api.cladasafaribliss.com
#   API mounted at /api on the site's domain (cPanel/DirectAdmin)
#                              NEXT_PUBLIC_API_URL=https://cladasafaribliss.com
# Uploaded images are allowed from these hosts in next.config.ts, at both
# /uploads/ and /api/uploads/.
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Shared secret for the Django -> Next.js revalidation webhook.
# Must match REVALIDATE_SECRET in cladasafari-api/.env.
REVALIDATE_SECRET=change-me-too

# Optional: the business's own Tawk.to embed URL enables live chat in the
# floating contact button, e.g. https://embed.tawk.to/<property>/<widget>
# NEXT_PUBLIC_TAWK_SRC=
